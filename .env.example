# ---- 실행 환경 ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- PostgreSQL ----
# 포트는 docker-compose.yml 과 맞춰야 한다 (기본값 회피, 15432)
# 오픈런 시 커넥션 풀이 병목이 된다. 좌석맵 조회 부하 참고 — 좌석맵을 캐시로 빼는 이유.
DATABASE_URL=postgresql+asyncpg://curtain:curtain@localhost:15432/curtain
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=3000

# ---- Redis ----
REDIS_URL=redis://localhost:16379/0

# ---- 인증 ----
JWT_SECRET=change-me-in-any-real-environment
JWT_ALG=HS256

# ---- PG 결제사 ----
# fake  : FakePG 어댑터 (지연·타임아웃·중복 콜백 주입 가능)
# real  : 실제 연동 (미룬 것에서 미룬 항목)
PG_ADAPTER=fake
PG_WEBHOOK_SECRET=change-me
FAKE_PG_LATENCY_MS=120
FAKE_PG_TIMEOUT_RATE=0.0
